---
import Navigation from './navi.astro';
import Menu from './menu.astro';
import ThemeIcon from './ThemeIcon.astro';
//<>
---
<Navigation /><br />
<header>
  <ThemeIcon />
  <nav>
    <div>
      <div class="header-image">
        <img class="headercontent" width="923" height="200" alt="oopsie, the image didnt load" src="/header.png" />
    </div>    
      <!-- <Menu /> -->
    </div>
  </nav>
</header>

<style>
  div {
    display: flex;
    justify-content: space-between;
  }
    .header-image {
      background: url(/noise.png);
      image-rendering: pixelated;
      position: relative;
      height: 200px;
      overflow: hidden;
    }
    .headercontent {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 70%;
    }

    header {
      position: relative;
      margin-bottom: 16px;
      border: 1px solid var(--border);
    }
    header h1 {
      position: absolute;
      bottom: 24px;
      left: 24px;
      font-family: var(--font-display);
      background: var(--gradient);
      color: #000;
      margin: 0;
      padding: 8px 16px;
      font-size: 16px;
    }

    nav {
      border-top: 1px solid var(--border);
      background: url(/noise.png);
    }
    nav a {
      display: inline-block;
      padding: 12px 24px;
      font-family: var(--font-small);
      border-right: 1px solid var(--border);
      color: var(--foreground);
      font-size: 12px;
      text-transform: uppercase;
      text-decoration: none;
    }
    nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
    }
    nav a:focus {
      outline: 1px dotted;
      outline-offset: -5px;
    }
</style>