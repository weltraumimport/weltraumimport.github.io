---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';
import Section from "../components/section.astro";

const pageTitle = "Home Page (ALL WORK IN PROGRESS)";
---
<BaseLayout pageTitle={pageTitle}>
  <main>
  <div id="content">
      <div class="left-column">
        <Section as="article" title="Welcomes!1^1">
          <Greeting client:load messages={["Technical Artist", "Dark Wizard", "3D-Generalist", "Tech Artist", "guy who solves weird problems"]} />
          <br />
          I'm interested in Shader Tricks and Pipeline Optimization for
