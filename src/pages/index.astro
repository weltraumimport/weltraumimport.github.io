          this is a second box for whatever info i wanna add.
          <ul>
            <li>list1</li>
            <li>list 2</li>
            <li>list entry 3</li>
            <li>nya</li>
          </ul>
          i can write so much in here and nobody can stop me
        </Section>

      </aside>
      </div>
  </main>

   <style>
    .left-column {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      gap: 16px;
    }

    aside {
      display: flex;
      flex-direction: column;
      gap: 16px;
      flex: 0 0 auto;
      width: 300px;
    }

    #socials ul {
      margin: 0;
    }

    #content {
      display: flex;
      gap: 16px;
      width: 100%;
      margin-top: 16px;
    }

    @media only screen and (max-width: 728px) {
      #content {
        flex-direction: column;
      }
      aside {
        width: 100%;
      }
    }
  </style>
</BaseLayout>